;
; sofapl.inf - Sound Open Firmware DSP driver for Intel Apollo Lake Chromebooks
; (binds to the Audio DSP child device created by sklhdaudbus)
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 11/09/2026,0.2.1.0
CatalogFile = sofapl.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
sofapl.sys         = 1,,
intel-sof-apl.ri   = 1,,

[Manufacturer]
%StdMfg%=Standard,NTAMD64

[Standard.NTAMD64]
%SofApl.DeviceDesc%=SofApl_Device, CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_5A98

[SofApl_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
sofapl.sys
intel-sof-apl.ri

[SofApl_Device.NT.Services]
AddService = sofapl,%SPSVCINST_ASSOCSERVICE%,SofApl_Service_Inst

[SofApl_Service_Inst]
DisplayName    = %SofApl.SvcDesc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\sofapl.sys

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ProviderName           = "chromebook-audio"
StdMfg                 = "chromebook-audio"
DiskId1                = "SOF Apollo Lake Installation Disk"
SofApl.DeviceDesc      = "Intel Audio DSP (Sound Open Firmware)"
SofApl.SvcDesc         = "SOF Apollo Lake DSP Service"
